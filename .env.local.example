NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# AI_PROVIDER selects the provider for the agentic chat (/api/chat).
AI_PROVIDER=gemini
# GEMINI_API_KEY powers the agentic chat (/api/chat via Google SDK). The chat
# model is set in config/agent.json, not here.
GEMINI_API_KEY=
# Free alternative: AI_PROVIDER=openrouter runs /api/chat on OpenRouter's free
# models (https://openrouter.ai/keys). AI_PROVIDER=groq works the same way with
# GROQ_API_KEY. AI_MODEL optionally overrides the default model.
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
